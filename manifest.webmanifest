self.addEventListener('install', function () {
  self.skipWaiting();
});

self.addEventListener('activate', function (event) {
  event.waitUntil(self.clients.claim());
});

self.addEventListener('fetch', function () {
  // PWA / service worker dinonaktifkan agar aplikasi tetap terbuka dengan normal
  // saat dibuka langsung dari index.html atau publish tanpa cache yang rusak.
});
